# Placeholders only. Do not commit the resulting .env or credential files.
# Read this file and export variables explicitly; the app does not load .env itself.
APP_ENV=local
STORAGE_BACKEND=local
LOCAL_DATA_DIR=/tmp/ccdc-local-data
GCP_PROJECT_ID=
GCS_BUCKET=
GCS_PREFIX=ccdc/local
MAX_UPLOAD_MB=25
MAX_UNCOMPRESSED_MB=512
MAX_ROWS=250000
MAX_COLUMNS=200
VALIDATION_WARNING_LIMITS={}
ADMIN_EMAILS=admin@example.com
# Mandatory exact expected IAP JWT audience for staging/production.
# Obtain it from the deployed service's verified IAP configuration/documentation.
# Do not substitute an OAuth client ID or copy the unsigned value from a request.
IAP_AUDIENCE=
LOG_LEVEL=INFO
